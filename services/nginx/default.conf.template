server {
    listen 443 ssl;
    client_max_body_size 2000M;
    proxy_read_timeout 600;
    proxy_connect_timeout 600;
    proxy_send_timeout 600;

    ssl_certificate /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;

    # Enable these when a client CA bundle is mounted at
    # /etc/nginx/certs/ca.crt and /aidocs mTLS enforcement is required.
    # ssl_client_certificate /etc/nginx/certs/ca.crt;
    # ssl_verify_client optional;
    # ssl_verify_depth 2;

    server_tokens off;
    server_name web;

    # Docker's embedded DNS, consulted while nginx runs.  A literal name in
    # proxy_pass is resolved once, when a worker starts, and that address is
    # kept for the life of the worker: recreating a service (every update does)
    # leaves nginx dialling the container that used to be there, and every
    # request fails with "connect() failed (111: Connection refused)" until
    # nginx itself is restarted.  A name held in a variable is resolved through
    # this resolver instead, so the new address is picked up within valid=.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # -----------------------------------------
    # REQUIRE mTLS only for /aidocs
    # -----------------------------------------
    location /aidocs/ {

        # deny if no valid client certificate
        #if ($ssl_client_verify != SUCCESS) {
        #    return 403;
        #}

        # optional: pass identity to backend
        #proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
        #proxy_set_header X-SSL-Client-DN $ssl_client_s_dn;

        # $request_uri because nginx drops the query string from a proxy_pass
        # that carries a variable and no URI of its own.
        set $aidocs_upstream ai_docs;
        proxy_pass http://$aidocs_upstream:4000$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /aidocs {
        return 301 /aidocs/;
    }

    # -----------------------------------------
    # everything else -> no mTLS required
    # -----------------------------------------
    location / {
        set $web_upstream web;
        proxy_pass http://$web_upstream:5000$request_uri;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    return 301 https://$host$request_uri;
}
