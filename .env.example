# ScanSuite host configuration.
#
# `scansuite install` copies this file to .env on first run and fills in every
# CHANGEME value: the passwords are generated with `openssl rand`, TZ is taken
# from the host clock and SCANSUITE_TAG is the release you installed.  .env is
# never tracked in this repository, so `git pull` cannot overwrite it.
#
# After editing anything here, apply it with: ./scansuite restart

# Release selected by `scansuite install|update`.  Do not edit by hand.
SCANSUITE_TAG=

# Optional services, switched on by the installer from the product manifest.
# COMPOSE_FILE=docker-compose.yml:compose.d/migrate.yml

ENABLE_STATIC_SCANS=True

LOG_FILE=/var/tmp/scansuite.log

CELERY_HOST=redis
REDIS_PASSWORD=CHANGEME

PS_DATABASE_HOST=postgres
PS_DATABASE_NAME=scansuite
PS_DATABASE_USER=scansuite
PS_DATABASE_PASSWORD=CHANGEME

STORAGE_URL=http://seaweedfs

NESSUS_USER=user
NESSUS_PASS=password
NESSUS_URL=https://your_nessus_host:8834

TZ=CHANGEME
