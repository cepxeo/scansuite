# ScanSuite host configuration.
#
# `scansuite install` copies this file to .env on first run and fills in every
# CHANGEME value: the passwords are generated with `openssl rand`, TZ is taken
# from the host clock and SCANSUITE_TAG is the release you installed.  .env is
# never tracked in this repository, so `git pull` cannot overwrite it.
#
# After editing anything here, apply it with: ./scansuite restart

# Release selected by `scansuite install|update`.  Do not edit by hand.
SCANSUITE_TAG=

# Optional services, switched on by the installer from the product manifest.
# COMPOSE_FILE=docker-compose.yml:compose.d/migrate.yml

# AI Pentest.  IMAGE_PENTEST is set by the installer from the product
# manifest.  The worker_pentest service (the IMAGE_PENTEST image)
# runs the scans' runners, one at a time per replica, each as a fresh process;
# the scanners run inside it.  How many runners may run at once on this host
# (the service's replicas), and what each may use:
# AI_PENTEST_MAX_RUNNERS=2
# AI_PENTEST_RUNNER_CPU=4
# AI_PENTEST_RUNNER_MEMORY=16g
# Raw sockets for nmap (SYN, UDP and OS scans) inside the runner, as Cloud Run
# jobs have them; off, port scans are TCP connect scans only.
# AI_PENTEST_RAW_SOCKETS=on
# On a Docker Desktop host, whose network drops port-scan probes sent many at
# once, the runners send fewer at a time with:
# AI_PENTEST_DOCKER_DESKTOP=1
# A large scope (more than 4 web applications or 64 addresses) is split into
# shards that runners work through together.  How many runners one scan may use
# at once (within AI_PENTEST_MAX_RUNNERS), the least share of the scan's model,
# request and scanner budget a shard gets (percent), and the requests per second
# all shards of a scan together send to one target host:
# AI_PENTEST_RUNNERS_PER_SCAN=4
# AI_PENTEST_SHARD_BUDGET_FLOOR=25
# AI_PENTEST_HOST_RPS=20
# The part of each AI connection's in-flight cap (Settings, AI) one sharded
# scan may hold at once, in percent, so a mass scan leaves room for the other
# scans; 0 or 100 lets it take the whole cap.  Connections without a cap are
# not limited either way.
# AI_PENTEST_SCAN_MODEL_SHARE=50

# Cross-site request forgery checks on browser forms and on the API calls the
# browser makes with its session cookie.  On unless set to false (0, no and off
# also work); keep it on for any installation a browser reaches, so that no
# other site can make a signed-in browser write to ScanSuite.  API tokens
# (Authorization: Bearer) carry no cookie and are never affected.
# CSRF_PROTECTION=false

# How many proxies stand in front of the application; the client address (rate
# limits, the sign-in log) is read from what the last of them forwards.  1 is the
# nginx this installation ships.  Set 2 when a load balancer or another reverse
# proxy sits in front of that nginx as well.
# TRUSTED_PROXY_HOPS=1

LOG_FILE=/var/tmp/scansuite.log

CELERY_HOST=redis
REDIS_PASSWORD=CHANGEME

PS_DATABASE_HOST=postgres
PS_DATABASE_NAME=scansuite
PS_DATABASE_USER=scansuite
PS_DATABASE_PASSWORD=CHANGEME
# PS_DATABASE_PORT=5432
# A separate schema owner for the migrate job, when the account above may not
# change the schema (an external PostgreSQL).  Unset, the migrate job uses the
# account above.  MIGRATION_DATABASE_URI, a full URI, overrides both.
# PS_MIGRATION_USER=
# PS_MIGRATION_PASSWORD=

# The largest upload (source archives, report imports), in MB.
# MAX_UPLOAD_MB=2000

# Anthropic prompt caching (Claude API, Foundry, Vertex): on unless set to 0,
# and the lifetime of the shared tools and system prefix, 1h (default) or 5m.
# SCANSUITE_PROMPT_CACHE=1
# SCANSUITE_PROMPT_CACHE_LONG_TTL=1h

# The exploitable-CVE feed between releases, all off unless set.  Pull a signed
# feed every few hours (both values are needed; an unsigned archive is never
# loaded), list CISA KEV and SSVC "active" CVEs every hour, and where pulled and
# imported archives are kept:
# VULNDB_FEED_URL=https://feed.example.com/scansuite
# VULNDB_FEED_PUBLIC_KEY=<base64 Ed25519 public key>
# VULNDB_FAST_LANE=1
# VULNDB_FEED_DIR=/tmp/scansuite-vulndb

STORAGE_URL=http://seaweedfs

TZ=CHANGEME
