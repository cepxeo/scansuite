###############################################################################
# Copy to terraform.tfvars and set project_id. Everything else has a working
# default; the values below are the ones worth thinking about.
###############################################################################

# Required.
project_id = "my-scansuite-project"

###############################################################################
# Location
#
# A Cloud Run service and worker pools, one job execution per scan and per AI
# Pentest runner. No cluster to operate.
###############################################################################

# Frankfurt. europe-west4 (Netherlands) is the nearest alternative; change
# primary_zone to match if you move.
region       = "europe-west3"
primary_zone = "europe-west3-b"

environment = "prod"

###############################################################################
# Access
###############################################################################

# Set true once you are past the first deployment. It stops `terraform destroy`
# from taking the database and the Cloud Run workloads with it.
deletion_protection = false

###############################################################################
# LLM / credentials identity
#
# The app authenticates to Cloud Storage and Vertex AI with an existing service
# account - no key is generated by Terraform. Point llm_service_account_email at
# it to grant the bucket and Vertex roles, and supply its key JSON so it can be
# injected at container start.
###############################################################################

# llm_service_account_email = "llm-scansuite@<project id>.iam.gserviceaccount.com"

# The key JSON, base64-encoded. Prefer leaving this empty and adding the secret
# version out of band so the key never enters Terraform state:
#   base64 -w0 llm-scansuit-key.json \
#     | gcloud secrets versions add scansuite-llm-sa-key-b64 --data-file=- --project <PROJECT>
# llm_sa_key_b64 = ""

###############################################################################
# Images
#
# The tag is your licence code: key/<name>_<code>.lic -> "<code>". The workloads
# read the images through an Artifact Registry remote repository in front of
# Docker Hub, pinned to the digests deploy.sh resolves; the appsec4u
# repositories are private, so the registry needs the Docker Hub user and token
# sent with your licence.
###############################################################################

image_tag = "000000"

dockerhub_username = "<user sent with your licence>"
# dockerhub_token: pass it without writing it to this file, e.g.
#   export TF_VAR_dockerhub_token='<token>'

# An internal registry instead (the three images under your own names, used as
# given, no digest pinning or remote repository):
# image_web        = "registry.example.internal/scansuite/ai-web:<code>"
# image_worker     = "registry.example.internal/scansuite/ai-worker:<code>"
# image_poc_runner = "registry.example.internal/scansuite/ai-poc-runner:<code>"

###############################################################################
# AI Pentest
#
# A <prefix>-pentest Cloud Run job runs the ai-worker-pentest image, every
# pentest tool inside, one task per runner.
# A scan's runners leave through the scan_egress_ips addresses.
###############################################################################

# pentest_max_runners          = 20       # runners of the whole installation at once
# pentest_safeguard_floor = "production"   # the floor below System settings -> AI Pentest safeguards
# Settings without a variable of their own, for every service and job (never a secret):
# extra_env = {
#   AI_PENTEST_RUNNERS_PER_SCAN     = "4"   # runners one scan may use at once
#   AI_PENTEST_SINGLE_SHARD_ORIGINS = "0"   # every web origin gets its own runner (default 4)
#   MAX_UPLOAD_MB                   = "2000"
#   SCANSUITE_PROMPT_CACHE_LONG_TTL = "1h"  # or "5m"; SCANSUITE_PROMPT_CACHE = "0" turns caching off
# }
# The exploitable-CVE database: the signed daily feed and the hourly CISA KEV
# fast lane are on with Cloud NAT and off with egress_mode = "none":
# vulndb_feed_url  = ""      # only the database that comes with each image; or a mirror's URL
# vulndb_fast_lane = false
# pentest_cpu                  = "4"
# pentest_memory               = "16Gi"
# pentest_task_timeout_seconds = 86400

###############################################################################
# PoC runs
#
# Each PoC runs as one execution of the <prefix>-poc job: the ai-poc-runner
# image, an identity with no roles, no secret, in a VPC of its own
# (<prefix>-poc-vpc) with no peering and no route but the internet through its
# own Cloud NAT: Cloud SQL, Memorystore and the workloads cannot be reached from
# it, whatever a firewall policy allows. Targets that allowlist by source see
# the poc_egress_ips output. worker-poc only hands the PoCs over. These are the
# defaults; an earlier terraform.tfvars needs none of them.
###############################################################################

poc_replicas             = 1              # the broker (worker-poc); it runs no PoC
poc_max_runners          = 10             # PoC executions of the installation at once
poc_task_timeout_seconds = 600            # one execution: the PoC (60 s), its start, its result
poc_network              = "own"          # "shared": a subnet of the installation's VPC behind a firewall rule
poc_subnet_cidr          = "10.20.8.0/26" # /26 or larger; with "shared" free in the VPC, apart from subnet_cidr and psa_cidr
poc_denied_ranges        = []             # public ranges the runner may not reach (private ones are closed already)
# One team runs at most 3 PoCs at once: extra_env POC_MAX_RUNNERS_PER_TEAM = "3".

###############################################################################
# TLS
#
# Without a domain the deployment still serves HTTPS, on the load balancer IP
# with a self-signed certificate. Set domain_name for a Google-managed one; the
# certificate provisions only once the name resolves to the load balancer, so
# the first apply will show it as PROVISIONING.
###############################################################################

# domain_name = "scansuite.example.com"
# manage_dns  = true

###############################################################################
# Who may reach the web UI
#
# Source ranges allowed through the external load balancer (Cloud Armor), up
# to 10. Empty = the whole internet. Set it before the first deploy: a new
# installation's setup page belongs to whoever opens it first. Not used with
# internal_only, where nothing is exposed.
###############################################################################

web_allowed_cidrs = ["203.0.113.10/32"]

###############################################################################
# Cloud Run sizing
#
# The writable filesystem is in memory and billed as memory, so scan_memory has
# to cover the repository clone as well as the process. Cloud Run caps an
# instance at 8 vCPU / 32Gi.
###############################################################################

scan_cpu                  = "4"
scan_memory               = "16Gi"
scan_task_timeout_seconds = 172800 # 48h, matching the Celery task_time_limit
web_min_instances         = 1
web_max_instances         = 4
admin_instances           = 1

###############################################################################
# Data services
###############################################################################

cloudsql_tier   = "db-custom-2-8192"
cloudsql_ha     = true
redis_memory_gb = 4
redis_ha        = true

# A dev deployment that costs roughly a third as much:
# cloudsql_tier   = "db-g1-small"
# cloudsql_ha     = false
# redis_ha        = false
# redis_memory_gb = 1

###############################################################################
# Integrations - all optional
###############################################################################

# None of them is Terraform configuration. Notifications are team
# integrations, set in each team's settings.
alert_email = "secops@example.com"

timezone = "Europe/Berlin"