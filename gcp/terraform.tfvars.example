###############################################################################
# Copy to terraform.tfvars and set project_id. Everything else has a working
# default; the values below are the ones worth thinking about.
###############################################################################

# Required.
project_id = "my-scansuite-project"

###############################################################################
# Platform
#
# cloudrun (default)  Cloud Run service + worker pools, one job execution per
#                     scan. No cluster to operate.
# gke                 The regional GKE cluster. Pick this when you need a
#                     termination grace period longer than Cloud Run's fixed
#                     ten seconds, or node-level control over the scan workers.
###############################################################################

platform = "cloudrun"

# Frankfurt. europe-west4 (Netherlands) is the nearest alternative; change
# zones and primary_zone to match if you move.
region       = "europe-west3"
zones        = ["europe-west3-a", "europe-west3-b", "europe-west3-c"]
primary_zone = "europe-west3-b"

environment = "prod"

###############################################################################
# Access
###############################################################################

# Leave commented out and Terraform allows the control plane to be reached from
# the IP address it is running from, and nothing else. Set it explicitly for CI.
# master_authorized_cidrs = ["203.0.113.10/32"]

# Set true once you are past the first deployment. It stops `terraform destroy`
# from taking the database and the cluster with it.
deletion_protection = false

###############################################################################
# LLM / credentials identity
#
# The app authenticates to Cloud Storage and Vertex AI with an existing service
# account - no key is generated by Terraform. Point llm_service_account_email at
# it to grant the bucket and Vertex roles, and supply its key JSON so it can be
# injected at container start.
###############################################################################

# llm_service_account_email = "llm-scansuit@cc-014550-pentesttools-dev-rh0.iam.gserviceaccount.com"

# The key JSON, base64-encoded. Prefer leaving this empty and adding the secret
# version out of band so the key never enters Terraform state:
#   base64 -w0 llm-scansuit-key.json \
#     | gcloud secrets versions add scansuite-llm-sa-key-b64 --data-file=- --project <PROJECT>
# llm_sa_key_b64 = ""

###############################################################################
# Images
#
# The tag is your licence code: key/<name>_<code>.lic -> "<code>". The workloads
# read the images through an Artifact Registry remote repository in front of
# Docker Hub, pinned to the digests deploy.sh resolves; the appsec4u
# repositories are private, so the registry needs the Docker Hub user and token
# sent with your licence.
###############################################################################

image_tag = "000000"

dockerhub_username = "<user sent with your licence>"
# dockerhub_token: pass it without writing it to this file, e.g.
#   export TF_VAR_dockerhub_token='<token>'

# An internal registry instead (the three images under your own names, used as
# given, no digest pinning or remote repository):
# image_web        = "registry.example.internal/scansuite/teams-web:<code>"
# image_worker     = "registry.example.internal/scansuite/teams-worker:<code>"
# image_worker_poc = "registry.example.internal/scansuite/teams-worker-poc:<code>"

###############################################################################
# Scope
#
# This deployment runs AI-native static analysis. It has no Docker daemon, so
# the dynamic and infrastructure scanners - which the worker launches as
# containers - cannot run. Leave this off unless you have added a daemon back.
###############################################################################

enable_static_scans  = "True"
enable_dynamic_scans = "False"

###############################################################################
# TLS
#
# Without a domain the deployment still serves HTTPS, on the load balancer IP
# with a self-signed certificate. Set domain_name for a Google-managed one; the
# certificate provisions only once the name resolves to the load balancer, so
# the first apply will show it as PROVISIONING.
###############################################################################

# domain_name = "scansuite.example.com"
# manage_dns  = true

###############################################################################
# Who may reach the web UI
#
# Source ranges allowed through the external load balancer (Cloud Armor), up
# to 10. Empty = the whole internet. Set it before the first deploy: a new
# installation's setup page belongs to whoever opens it first. Not used with
# internal_only, where nothing is exposed.
###############################################################################

web_allowed_cidrs = ["203.0.113.10/32"]

###############################################################################
# Cloud Run sizing (platform = cloudrun)
#
# The writable filesystem is in memory and billed as memory, so scan_memory has
# to cover the repository clone as well as the process. Cloud Run caps an
# instance at 8 vCPU / 32Gi.
###############################################################################

scan_cpu                  = "4"
scan_memory               = "16Gi"
scan_task_timeout_seconds = 172800 # 48h, matching the Celery task_time_limit
web_min_instances         = 1
web_max_instances         = 4
admin_instances           = 1

###############################################################################
# Data services (both platforms)
###############################################################################

cloudsql_tier   = "db-custom-2-8192"
cloudsql_ha     = true
redis_memory_gb = 4
redis_ha        = true

# GKE node sizing (platform = gke only)
scan_engine_machine_type = "n2-standard-4"
scratch_disk_gb          = 200
worker_replicas          = 1

# A dev deployment that costs roughly a third as much:
# cloudsql_tier            = "db-g1-small"
# cloudsql_ha              = false
# redis_ha                 = false
# redis_memory_gb          = 1
# scan_engine_machine_type = "n2-standard-2"
# scratch_disk_gb          = 100
# poc_replicas             = 1

###############################################################################
# Integrations - all optional
###############################################################################

# None of them is Terraform configuration. DefectDojo, SecurITM, OpenVAS,
# Acunetix and notifications are team integrations, set in each team's
# settings; the shared Nessus scanner is set in System Settings, where its
# password is stored encrypted.
alert_email = "secops@example.com"

timezone = "Europe/Berlin"