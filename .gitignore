# Per-host state.  The installation is a checkout of this repository, so
# anything the host generates must stay untracked or `git pull` would fight it.
.env
.env.bak-*
.replaced-*/
# What `scansuite backup` writes when it is given no other place.
backups/
key/*.lic
key/key.json
key/scansuite-secrets.env
docker-compose.local.yml
# This host's TLS certificate and key: created at install, or the operator's.
services/nginx/certs/*.pem
# A deployment to Google Cloud from gcp/: its settings, state and provider cache.
gcp/.terraform/
gcp/terraform.tfvars
gcp/*.tfstate
gcp/*.tfstate.*
gcp/images.auto.tfvars.json
gcp/images.migrated.json
gcp/images.current.json
gcp/backend.tf
gcp/crash.log
