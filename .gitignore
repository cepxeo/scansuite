# Per-host state.  The installation is a checkout of this repository, so
# anything the host generates must stay untracked or `git pull` would fight it.
.env
.env.bak-*
docker-compose.yml.pre-*
.replaced-*/
key/*.lic
key/key.json
key/scansuite-secrets.env
docker-compose.local.yml
# A deployment to Azure from azure/: its settings, state and provider cache.
azure/.terraform/
azure/terraform.tfvars
azure/*.tfstate
azure/*.tfstate.*
azure/images.auto.tfvars.json
azure/backend.tf
azure/crash.log
